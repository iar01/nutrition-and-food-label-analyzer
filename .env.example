# ==============================================================================
# LabelLens Environment Configuration Template
# ==============================================================================
# Total environment variables:
#   - Backend (Python / FastAPI): 43 variables (configured in root .env)
#   - Frontend (Next.js): 2 variables (configured in apps/web/.env.local)
#
# QUICK START:
# 1. Generate a secure random API key using Python:
#      python -c "import secrets; print(secrets.token_urlsafe(32))"
# 2. Set API_KEYS=<generated_key> below in your .env file.
# 3. In apps/web/.env.local, set LABELLENS_API_KEY=<generated_key>.
#
# NOTE: All backend variables below have sensible defaults in code.
#       NEVER commit your actual .env file or real secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Logging Environment (2 variables)
# ------------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 2. PostgreSQL Relational Database (7 variables)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=labellens
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/labellens
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/labellens

# ------------------------------------------------------------------------------
# 3. Qdrant Vector Database (5 variables)
# ------------------------------------------------------------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ------------------------------------------------------------------------------
# 4. LLM Configuration (OpenAI-compatible) (5 variables)
# ------------------------------------------------------------------------------
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=ollama
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60.0

# ------------------------------------------------------------------------------
# 5. Embedding & Reranker Models (5 variables)
# ------------------------------------------------------------------------------
TEXT_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
IMAGE_EMBEDDING_MODEL=ViT-B-32
IMAGE_EMBEDDING_PRETRAINED=openai
SPARSE_EMBEDDING_MODEL=Qdrant/bm25
RERANKER_MODEL=BAAI/bge-reranker-base

# ------------------------------------------------------------------------------
# 6. Observability & Tracing (3 variables)
# ------------------------------------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=labellens

# ------------------------------------------------------------------------------
# 7. Qdrant Collection Names (2 variables)
# ------------------------------------------------------------------------------
PRODUCTS_COLLECTION=products
KNOWLEDGE_COLLECTION=knowledge

# ------------------------------------------------------------------------------
# 8. Data Storage & Interim Artifact Paths (7 variables)
# ------------------------------------------------------------------------------
CLEAN_PRODUCTS_PATH=data/clean/products.parquet
IMAGES_DIR=data/images
IMAGE_KEYS_PATH=data/raw/data_keys.gz
EMBEDDINGS_DIR=data/embeddings
PRODUCT_DB_PATH=data/interim/products.duckdb
CHECKPOINT_DB_PATH=data/checkpoints.sqlite
FEEDBACK_DB_PATH=data/feedback.sqlite

# ------------------------------------------------------------------------------
# 9. Model Context Protocol (MCP) Integration (2 variables)
# ------------------------------------------------------------------------------
MCP_URL=http://127.0.0.1:8765/mcp
MCP_AUTH_TOKEN=

# ------------------------------------------------------------------------------
# 10. API Gateway Security, CORS & Rate Limits (5 variables)
# ------------------------------------------------------------------------------
# Comma-separated list of valid client API keys. Generate via:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=your_generated_api_key_here
CORS_ORIGINS=http://localhost:3000
API_MAX_UPLOAD_BYTES=4000000
API_RATE_LIMIT_PER_MINUTE=60
API_MAX_CONCURRENT_RUNS=2

# ------------------------------------------------------------------------------
# 11. Frontend Environment Reference (apps/web/.env.local) (2 variables)
# ------------------------------------------------------------------------------
# Set these in apps/web/.env.local for Next.js frontend proxy:
# LABELLENS_API_URL=http://127.0.0.1:8000
# LABELLENS_API_KEY=your_generated_api_key_here
