# ==============================================================================
# LabelLens Environment Configuration Template
# Copy this file to .env and adjust variables for your local development environment.
# NEVER commit real credentials or actual .env files to version control.
# ==============================================================================

# Application Environment
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=labellens
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/labellens
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/labellens

# Qdrant Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# LLM Configuration (OpenAI-compatible endpoint, e.g. Ollama or cloud provider)
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=ollama
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60

# Embeddings & Reranking Models
TEXT_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
IMAGE_EMBEDDING_MODEL=ViT-B-32
IMAGE_EMBEDDING_PRETRAINED=openai
SPARSE_EMBEDDING_MODEL=Qdrant/bm25
RERANKER_MODEL=BAAI/bge-reranker-base

# Observability (Optional: LangSmith / Langfuse)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=labellens
 
# API Gateway & FastAPI Configuration
API_KEYS=your_comma_separated_api_keys
CORS_ORIGINS=http://localhost:3000
API_MAX_UPLOAD_BYTES=4000000
API_RATE_LIMIT_PER_MINUTE=60
API_MAX_CONCURRENT_RUNS=2
FEEDBACK_DB_PATH=data/feedback.sqlite
