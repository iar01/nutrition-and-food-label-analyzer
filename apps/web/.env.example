# ==============================================================================
# LabelLens Next.js Frontend Environment Template
# ==============================================================================
# Copy this file to apps/web/.env.local for local frontend development:
#   cp apps/web/.env.example apps/web/.env.local
#
# The Next.js frontend application uses exactly 2 environment variables:
#
# 1. LABELLENS_API_URL:
#    Upstream FastAPI backend URL reached by Next.js server-side route handler.
#    Default: http://127.0.0.1:8000
#
# 2. LABELLENS_API_KEY:
#    Secret API key forwarded by the server proxy to the backend via X-API-Key.
#    Never prefixed with NEXT_PUBLIC_ so it remains strictly on the Next.js server.
#
# HOW TO GENERATE A SECURE API KEY:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Ensure LABELLENS_API_KEY matches one of the keys listed in root .env API_KEYS.
# NEVER commit your actual .env.local file or secrets to version control.
# ==============================================================================

LABELLENS_API_URL=http://127.0.0.1:8000
LABELLENS_API_KEY=your_generated_api_key_here
