{
  "openapi": "3.1.0",
  "info": {
    "title": "LabelLens API",
    "description": "Analyse packaged food: allergens, diets, additives and alternatives. Data from Open Food Facts (ODbL). General information, not medical advice.",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Health",
        "description": "Liveness: the process is up.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Ready",
        "description": "Readiness: can the service do its job? Critical failures give 503, others give 'degraded'.",
        "operationId": "ready_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyOut"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyOut"
                }
              }
            }
          }
        }
      }
    },
    "/v1/products/{code}": {
      "get": {
        "tags": [
          "products"
        ],
        "summary": "Get Product",
        "operationId": "get_product_v1_products__code__get",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^\\d{8,14}$",
              "description": "Barcode, 8 to 14 digits.",
              "title": "Code"
            },
            "description": "Barcode, 8 to 14 digits."
          },
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductSummary"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/search": {
      "get": {
        "tags": [
          "products"
        ],
        "summary": "Search",
        "operationId": "search_v1_search_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 200,
              "description": "Product name, brand or description.",
              "title": "Q"
            },
            "description": "Product name, brand or description."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 10,
              "minimum": 1,
              "default": 5,
              "title": "Limit"
            }
          },
          {
            "name": "diet",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "enum": [
                      "vegan",
                      "vegetarian",
                      "gluten_free",
                      "lactose_free",
                      "palm_oil_free",
                      "nut_free"
                    ],
                    "type": "string"
                  }
                },
                {
                  "type": "null"
                }
              ],
              "title": "Diet"
            }
          },
          {
            "name": "exclude_allergen",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "enum": [
                      "milk",
                      "eggs",
                      "peanuts",
                      "nuts",
                      "soy",
                      "gluten",
                      "fish",
                      "crustaceans",
                      "molluscs",
                      "sesame",
                      "celery",
                      "mustard",
                      "lupin",
                      "sulphites"
                    ],
                    "type": "string"
                  }
                },
                {
                  "type": "null"
                }
              ],
              "title": "Exclude Allergen"
            }
          },
          {
            "name": "nutriscore",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "enum": [
                      "a",
                      "b",
                      "c",
                      "d",
                      "e"
                    ],
                    "type": "string"
                  }
                },
                {
                  "type": "null"
                }
              ],
              "title": "Nutriscore"
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 100
                },
                {
                  "type": "null"
                }
              ],
              "title": "Category"
            }
          },
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/feedback": {
      "post": {
        "tags": [
          "feedback"
        ],
        "summary": "Feedback",
        "description": "Store a thumbs up or down for an earlier answer.",
        "operationId": "feedback_v1_feedback_post",
        "parameters": [
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FeedbackIn"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FeedbackOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/analyze": {
      "post": {
        "tags": [
          "analysis"
        ],
        "summary": "Analyze",
        "description": "Analyse one product from a barcode, a text query or a photo.\n\nPriority: barcode, then image, then text. For text queries the first match is used and the\nother matches are returned in `candidates`.",
        "operationId": "analyze_v1_analyze_post",
        "parameters": [
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_analyze_v1_analyze_post"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalyzeResponse"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Not Found"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Request Entity Too Large"
          },
          "415": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Unsupported Media Type"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Service Unavailable"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/chat": {
      "post": {
        "tags": [
          "analysis"
        ],
        "summary": "Chat",
        "description": "Run the agent and stream progress as Server-Sent Events.",
        "operationId": "chat_v1_chat_post",
        "parameters": [
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Server-Sent Events stream.",
            "content": {
              "application/json": {
                "schema": {}
              },
              "text/event-stream": {}
            }
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Conflict"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Service Unavailable"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AdditiveNote": {
        "properties": {
          "e_number": {
            "type": "string",
            "title": "E Number"
          },
          "explanation": {
            "type": "string",
            "title": "Explanation"
          },
          "relevant_to_user": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Relevant To User"
          },
          "evidence_id": {
            "type": "string",
            "title": "Evidence Id"
          }
        },
        "type": "object",
        "required": [
          "e_number",
          "explanation",
          "evidence_id"
        ],
        "title": "AdditiveNote"
      },
      "AdditiveSection": {
        "properties": {
          "notes": {
            "items": {
              "$ref": "#/components/schemas/AdditiveNote"
            },
            "type": "array",
            "title": "Notes"
          },
          "missing": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Missing"
          }
        },
        "type": "object",
        "title": "AdditiveSection"
      },
      "AlternativeOut": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "brand": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Brand"
          },
          "nutriscore": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Nutriscore"
          }
        },
        "type": "object",
        "required": [
          "code"
        ],
        "title": "AlternativeOut"
      },
      "AnalyzeResponse": {
        "properties": {
          "product": {
            "$ref": "#/components/schemas/ProductSummary"
          },
          "verdicts": {
            "$ref": "#/components/schemas/Verdicts"
          },
          "ingredients": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/IngredientFindings"
              },
              {
                "type": "null"
              }
            ]
          },
          "additives": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AdditiveSection"
              },
              {
                "type": "null"
              }
            ]
          },
          "alternatives": {
            "items": {
              "$ref": "#/components/schemas/AlternativeOut"
            },
            "type": "array",
            "title": "Alternatives"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/EvidenceOut"
            },
            "type": "array",
            "title": "Evidence"
          },
          "answer_markdown": {
            "type": "string",
            "title": "Answer Markdown"
          },
          "matched_by": {
            "type": "string",
            "enum": [
              "barcode",
              "text",
              "image"
            ],
            "title": "Matched By"
          },
          "candidates": {
            "items": {
              "$ref": "#/components/schemas/CandidateOut"
            },
            "type": "array",
            "title": "Candidates"
          },
          "thread_id": {
            "type": "string",
            "title": "Thread Id"
          },
          "request_id": {
            "type": "string",
            "title": "Request Id"
          }
        },
        "type": "object",
        "required": [
          "product",
          "verdicts",
          "answer_markdown",
          "matched_by",
          "thread_id",
          "request_id"
        ],
        "title": "AnalyzeResponse"
      },
      "Body_analyze_v1_analyze_post": {
        "properties": {
          "barcode": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{8,14}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Barcode"
          },
          "text": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 300,
                "minLength": 2
              },
              {
                "type": "null"
              }
            ],
            "title": "Text"
          },
          "profile": {
            "type": "string",
            "maxLength": 2000,
            "title": "Profile",
            "default": "{}"
          },
          "image": {
            "anyOf": [
              {
                "type": "string",
                "contentMediaType": "application/octet-stream"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image"
          }
        },
        "type": "object",
        "title": "Body_analyze_v1_analyze_post"
      },
      "CandidateOut": {
        "properties": {
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Code"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "brands": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Brands"
          },
          "nutriscore": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Nutriscore"
          },
          "score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Score"
          }
        },
        "type": "object",
        "title": "CandidateOut"
      },
      "ChatRequest": {
        "properties": {
          "message": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500,
                "minLength": 2
              },
              {
                "type": "null"
              }
            ],
            "title": "Message"
          },
          "thread_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9-]{8,64}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Thread Id"
          },
          "resume_code": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{8,14}$",
                "description": "Product barcode (EAN or UPC), 8 to 14 digits."
              },
              {
                "type": "null"
              }
            ],
            "title": "Resume Code"
          },
          "profile": {
            "$ref": "#/components/schemas/Profile"
          },
          "auto_pick": {
            "type": "boolean",
            "title": "Auto Pick",
            "default": false
          }
        },
        "type": "object",
        "title": "ChatRequest",
        "description": "Start a new analysis with `message`, or resume a paused one with `thread_id` + `resume_code`."
      },
      "CheckResult": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "ok": {
            "type": "boolean",
            "title": "Ok"
          },
          "critical": {
            "type": "boolean",
            "title": "Critical"
          }
        },
        "type": "object",
        "required": [
          "name",
          "ok",
          "critical"
        ],
        "title": "CheckResult"
      },
      "ErrorOut": {
        "properties": {
          "error": {
            "type": "string",
            "title": "Error"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "request_id": {
            "type": "string",
            "title": "Request Id"
          }
        },
        "type": "object",
        "required": [
          "error",
          "message",
          "request_id"
        ],
        "title": "ErrorOut"
      },
      "EvidenceOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "source_url": {
            "type": "string",
            "title": "Source Url",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "id",
          "kind",
          "title",
          "text"
        ],
        "title": "EvidenceOut"
      },
      "FeedbackIn": {
        "properties": {
          "rating": {
            "type": "string",
            "enum": [
              "up",
              "down"
            ],
            "title": "Rating"
          },
          "comment": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Comment"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          },
          "thread_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ],
            "title": "Thread Id"
          },
          "product_code": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{8,14}$",
                "description": "Product barcode (EAN or UPC), 8 to 14 digits."
              },
              {
                "type": "null"
              }
            ],
            "title": "Product Code"
          }
        },
        "type": "object",
        "required": [
          "rating"
        ],
        "title": "FeedbackIn"
      },
      "FeedbackOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          }
        },
        "type": "object",
        "required": [
          "id"
        ],
        "title": "FeedbackOut"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IngredientFindings": {
        "properties": {
          "notable": {
            "items": {
              "$ref": "#/components/schemas/Notable"
            },
            "type": "array",
            "title": "Notable"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          }
        },
        "type": "object",
        "required": [
          "summary"
        ],
        "title": "IngredientFindings"
      },
      "Notable": {
        "properties": {
          "item": {
            "type": "string",
            "title": "Item"
          },
          "why": {
            "type": "string",
            "title": "Why"
          },
          "evidence_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Evidence Ids"
          }
        },
        "type": "object",
        "required": [
          "item",
          "why"
        ],
        "title": "Notable"
      },
      "NutritionItem": {
        "properties": {
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
